# ============================================================================
#  .env.example - environment variables for the auth-app frontend
#
#  Usage:
#    1. Copy this file to `.env` (optional — sensible defaults exist in code).
#    2. Adjust values if your backend runs on a non-default host/port.
#    3. NEVER commit `.env` to git.
#
#  Vite exposes any variable prefixed with `VITE_` to your JS/JSX code via
#  `import.meta.env.VITE_<NAME>`. Anything not prefixed is ignored client-side.
# ============================================================================


# Base URL of the Spring Boot backend.
# Default (if unset): http://localhost:8080  — see services/api.js
VITE_API_BASE_URL=http://localhost:8080
